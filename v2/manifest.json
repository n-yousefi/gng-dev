{
  "manifest_version": 3,
  "name": "GIG Component Inspector",
  "version": "0.4.0",
  "key": "",
  "description": "Side panel for inspecting rendered GIG/GNG Angular component trees — no DevTools required.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open GIG Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "sidePanel",
    "scripting",
    "tabs",
    "windows"
  ],
  "host_permissions": ["<all_urls>", "file:///*"]
}
